  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "HookRelay Webhook Platform Observability",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "title": "Ingested Events Rate by Tenant (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hookrelay_events_ingested_total[1m])) by (tenant_id)",
          "legendFormat": "Tenant {{tenant_id}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "title": "Delivery Attempts by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hookrelay_deliveries_attempted_total[1m])) by (status)",
          "legendFormat": "Status: {{status}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "title": "Webhook Dispatch Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hookrelay_delivery_latency_seconds_bucket[1m])) by (le, endpoint_id))",
          "legendFormat": "Endpoint {{endpoint_id}} (p95)"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 5,
      "title": "Pending Queue Depth (PostgreSQL SKIP LOCKED)",
      "type": "stat",
      "targets": [
        {
          "expr": "hookrelay_deliveries_queue_depth",
          "legendFormat": "Pending Jobs"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 6,
      "title": "Rate Limit Rejections (429s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hookrelay_rate_limit_rejected_total[1m])) by (tenant_id)",
          "legendFormat": "Tenant {{tenant_id}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hookrelay", "webhooks", "reliability"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "HookRelay Production Overview",
  "uid": "hookrelay-production-overview",
  "version": 1
